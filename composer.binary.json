{
  "name": "dreamfactory/dreamfactory-quickstart",
  "description": "DreamFactory Quickstart binary packaging for fast governed API adoption.",
  "keywords": [
    "api",
    "dreamfactory",
    "rest",
    "database"
  ],
  "homepage": "https://www.dreamfactory.com/",
  "license": "Apache-2.0",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-mysqldb.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-sqlsrv.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-admin-interface.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-sqldb.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-system.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-user.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-core.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-ai.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-ai-chat.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-api-builder.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/dreamfactorysoftware/df-agents.git"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.7",
    "laravel/helpers": "^1.8",
    "laravel/tinker": "^3.0",
    "symfony/css-selector": "^7.4",
    "dreamfactory/df-core": "dev-develop#e9f13bb990c85be07eeb9773b90d90d1621fc646 as 1.0.99",
    "dreamfactory/df-system": "~0.6.5",
    "dreamfactory/df-user": "~0.17.2",
    "dreamfactory/df-cache": "~0.13.1",
    "dreamfactory/df-apidoc": "~0.8.3",
    "dreamfactory/df-file": "~0.9.1",
    "dreamfactory/df-sqldb": "dev-develop#0d0267b7aad4cba1a5d25cab6128984ede03c38a as 1.5.99",
    "dreamfactory/df-mysqldb": "~0.4.0",
    "dreamfactory/df-sqlsrv": "dev-develop#65fa4226424e8569a58dd7132aa5c7895375faa0 as 0.18.99",
    "dreamfactory/df-rws": "~0.18.2",
    "dreamfactory/df-soap": "~0.17.3",
    "dreamfactory/df-admin-interface": "~1.7.7",
    "dreamfactory/df-ai": "~0.1.0",
    "dreamfactory/df-ai-chat": "~0.1.0",
    "dreamfactory/df-agents": "dev-develop#d6f57b30e35fde0912e9ba48ba10e425e3c73f51 as 0.1.99",
    "dreamfactory/df-api-builder": "~0.1.1"
  },
  "conflict": {
    "symfony/cache": ">=8.0",
    "symfony/clock": ">=8.0",
    "symfony/console": ">=8.0",
    "symfony/css-selector": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/event-dispatcher": ">=8.0",
    "symfony/filesystem": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/http-client": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/mailer": ">=8.0",
    "symfony/mailgun-mailer": ">=8.0",
    "symfony/mime": ">=8.0",
    "symfony/options-resolver": ">=8.0",
    "symfony/process": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/translation": ">=8.0",
    "symfony/uid": ">=8.0",
    "symfony/var-dumper": ">=8.0",
    "symfony/var-exporter": ">=8.0",
    "symfony/yaml": ">=8.0"
  },
  "autoload": {
    "classmap": [
      "database/seeds",
      "database/factories"
    ],
    "psr-4": {
      "DreamFactory\\": "app/"
    }
  },
  "extra": {
    "installer-paths": {
      "public/{$name}/": [
        "type:dreamfactory-app"
      ]
    },
    "laravel": {
      "dont-discover": [
        "mongodb/laravel-mongodb"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "dreamfactory/installer": true
    }
  }
}
